APP_NAME=ALPHA
APP_ENV=development

DATABASE_URL=postgresql+asyncpg://ALPHA:ALPHA@localhost:5432/ALPHA

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=
# Modelo de visão local (ex.: gemma3:4b) usado para descrever screenshots.
# Pode ser diferente do OLLAMA_MODEL; se vazio, o screenshot volta só o caminho.
OLLAMA_VISION_MODEL=
GEMINI_API_KEY=
GOOGLE_API_KEY=
API_KEY=
GEMINI_MODEL=gemini-2.0-flash
LLM_MODE=auto
ALLOW_CLOUD_LLM=true
ALLOW_WEB=true

STT_ENABLED=true
STT_MODEL_SIZE=small
STT_LANGUAGE=pt
STT_DEVICE=auto
STT_COMPUTE_TYPE=auto
# Vocabulário que guia a transcrição (faster-whisper initial_prompt) para comandos
# de voz comuns. Deixe vazio para desativar e não enviesar ditados gerais.
STT_INITIAL_PROMPT=navegador, abrir o navegador, abrir o chrome, Prime Video, YouTube, abrir o aplicativo, dar play, pausar, fechar, digitar, escrever, clicar, buscar, pesquisar, arquivo, pasta, downloads, documentos.

# Wake word do modo viva-voz (M6): ativa a escuta quando você diz uma das palavras.
# WAKE_WORD_ENABLED=true liga por padrão; também dá para usar `chat --wake`.
# Palavras separadas por vírgula; use termos curtos que o STT transcreve bem.
WAKE_WORD_ENABLED=false
WAKE_WORDS=alpha

TTS_ENABLED=true
TTS_VOICE=
TTS_SPEED=1.0

MEMORY_MIN_IMPORTANCE=0.70
RAG_TOP_K=5
AGENT_MAX_TOOL_ITERATIONS=8

# Agendador de lembretes/ações automáticas (M4).
# Scheduler rodando em segundo plano no servidor da API e no chat interativo do CLI.
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_SECONDS=15.0

# Diretórios que o agente pode acessar, separados por ; (Windows) ou : (Linux/macOS).
# Vazio usa padrões: diretório atual, home, Downloads, Documentos e Desktop.
ALLOWED_DIRECTORIES=
