APP_NAME=ALPHA
APP_ENV=development

DATABASE_URL=postgresql+asyncpg://ALPHA:ALPHA@localhost:5432/ALPHA

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=
OLLAMA_VISION_MODEL=

# LLM principal: hybrid usa Ollama para tarefas simples e o gateway local
# para tarefas mais complexas. O gateway pode ser 9Router ou outro endpoint
# compatível com OpenAI. ALPHA não gerencia nem tenta contornar quotas.
LLM_MODE=hybrid
ALLOW_CLOUD_LLM=true
CLOUD_LLM_ENABLED=true
CLOUD_LLM_BASE_URL=http://127.0.0.1:20128/v1
CLOUD_LLM_API_KEY=
# 9Router expõe "alpha" como combo/perfil; o gateway escolhe o modelo upstream.
CLOUD_LLM_MODEL=alpha
CLOUD_LLM_TIMEOUT_SECONDS=120
HYBRID_CLOUD_FOR_COMPLEX=true
HYBRID_CLOUD_FALLBACK=true

# Gemini continua disponível como fallback/legado quando configurado.
GEMINI_API_KEY=
GOOGLE_API_KEY=
API_KEY=
GEMINI_MODEL=gemini-2.0-flash
ALLOW_WEB=true

STT_ENABLED=true
STT_MODEL_SIZE=small
STT_LANGUAGE=pt
STT_DEVICE=auto
STT_COMPUTE_TYPE=auto
STT_INITIAL_PROMPT=navegador, abrir o navegador, abrir o chrome, Prime Video, YouTube, abrir o aplicativo, dar play, pausar, fechar, digitar, escrever, clicar, buscar, pesquisar, arquivo, pasta, downloads, documentos.

WAKE_WORD_ENABLED=false
WAKE_WORDS=alpha

TTS_ENABLED=true
TTS_VOICE=
TTS_SPEED=1.0

MEMORY_MIN_IMPORTANCE=0.80
RAG_TOP_K=3
AGENT_MAX_TOOL_ITERATIONS=6
AGENT_TOOL_SELECTION=true
AGENT_AUTO_APPROVE_SENSITIVE=false
AGENT_TOOL_RESULT_STRICT=true
AGENT_REQUIRE_TOOL_VERIFICATION=false

SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_SECONDS=15.0

ALLOWED_DIRECTORIES=
